{
  "name": "diashow-studio",
  "productName": "Diashow Studio",
  "version": "0.1.0",
  "description": "Photo and video slideshows for Windows, inspired by the macOS Photos slideshow feature",
  "main": "./out/main/index.js",
  "author": "ASAMedia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:media": "node scripts/make-test-media.mjs",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "exiftool-vendored": "^39.0.1",
    "libraw-wasm": "1.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.54.0",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  }
}
