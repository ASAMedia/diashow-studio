{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "isolatedModules": true,
    "resolveJsonModule": true, "composite": true, "types": [],
    "paths": { "@shared/*": ["./src/shared/*"], "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts", "tests/grouping.test.ts", "tests/cleanupPixelation.test.ts", "tests/editFraming.test.ts"]
}
